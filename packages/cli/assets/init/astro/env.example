# Settings → Headless in the cmssy dashboard
CMSSY_ORG_SLUG=
CMSSY_WORKSPACE_SLUG=

# Also Settings → Headless. The editor proves itself with this secret, so an
# unverified ?cmssyEdit=1 cannot open the door.
CMSSY_DRAFT_SECRET=
# Optional, server-only: a cs_ API token scoped to this workspace (Dashboard -> API Tokens).
# Server delivery reads send it, so a build is budgeted per workspace, not per IP.
# Delivery reads need no write permission; `cmssy sync-manifest` reads the same var and needs pages:edit.
CMSSY_API_TOKEN=

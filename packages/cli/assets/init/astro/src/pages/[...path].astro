---
import { loadCmssyPage } from "@cmssy/astro";
import {
  resolveEditorBlockData,
  resolveEditorLayoutBlockData,
} from "@cmssy/react";
import { cmssy } from "../cmssy.config";
import { blocks } from "../cmssy/blocks";
import { Blocks } from "../components/Blocks";
import LayoutSlot from "../cmssy/layout-slot";

export const prerender = false;

const { page, layouts, pageContext, locale, defaultLocale, enabledLocales } = await loadCmssyPage(
  cmssy,
  Astro.request,
  Astro.url,
  { blocks },
);

if (!page) {
  Astro.response.status = 404;
}

const { data: blockData, content: blockContent } = await resolveEditorBlockData({
  page,
  blocks,
  locale,
  defaultLocale,
  enabledLocales,
  config: cmssy,
});

const layoutSlot = {
  groups: layouts,
  page: pageContext,
  blocks,
  locale,
  defaultLocale,
  enabledLocales,
  config: cmssy,
};
const [header, footer] = await Promise.all([
  resolveEditorLayoutBlockData({ ...layoutSlot, position: "header" }),
  resolveEditorLayoutBlockData({ ...layoutSlot, position: "footer" }),
]);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>{page?.seoTitle?.[locale] ?? page?.displayName?.[locale] ?? "cmssy on Astro"}</title>
  </head>
  <body>
    <LayoutSlot
      groups={layouts}
      position="header"
      page={pageContext}
      locale={locale}
      defaultLocale={defaultLocale}
      enabledLocales={enabledLocales}
      data={header.data}
      resolvedContent={header.content}
    />
    {
      page ? (
        <Blocks
          page={page}
          locale={locale}
          defaultLocale={defaultLocale}
          enabledLocales={enabledLocales}
          blockData={blockData}
          blockContent={blockContent}
        />
      ) : (
        <main><h1>Not found</h1></main>
      )
    }
    <LayoutSlot
      groups={layouts}
      position="footer"
      page={pageContext}
      locale={locale}
      defaultLocale={defaultLocale}
      enabledLocales={enabledLocales}
      data={footer.data}
      resolvedContent={footer.content}
    />
  </body>
</html>

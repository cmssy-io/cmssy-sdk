---
import { loadCmssyPage } from "@cmssy/astro";
import { cmssy } from "../cmssy.config";
import { blocks } from "../cmssy/blocks";
import { Blocks } from "../components/Blocks";
import LayoutSlot from "../cmssy/layout-slot";

export const prerender = false;

// `blocks` is what lets the loader resolve the editor's layout data. Drop it
// and the site still renders - the editor just cannot fill the header.
const { page, layouts, locale, defaultLocale, enabledLocales } = await loadCmssyPage(
  cmssy,
  Astro.request,
  Astro.url,
  { blocks },
);

if (!page) {
  Astro.response.status = 404;
}
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>{page?.seoTitle?.[locale] ?? page?.displayName?.[locale] ?? "cmssy on Astro"}</title>
  </head>
  <body>
    <LayoutSlot
      groups={layouts}
      position="header"
      locale={locale}
      defaultLocale={defaultLocale}
      enabledLocales={enabledLocales}
    />
    {
      page ? (
        <Blocks
          page={page}
          locale={locale}
          defaultLocale={defaultLocale}
          enabledLocales={enabledLocales}
        />
      ) : (
        <main><h1>Not found</h1></main>
      )
    }
    <LayoutSlot
      groups={layouts}
      position="footer"
      locale={locale}
      defaultLocale={defaultLocale}
      enabledLocales={enabledLocales}
    />
  </body>
</html>

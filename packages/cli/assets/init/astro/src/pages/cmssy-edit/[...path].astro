---
import { loadCmssyPage, resolveEditorOrigin } from "@cmssy/astro";
import { cmssy } from "../../cmssy.config";
import { blocks } from "../../cmssy/blocks";
import CmssyEditor from "../../cmssy/editor";
import LayoutSlot from "../../cmssy/layout-slot";

export const prerender = false;

const {
  page,
  layouts,
  pageContext,
  locale,
  defaultLocale,
  enabledLocales,
  editorData,
  layoutRegions,
} = await loadCmssyPage(cmssy, Astro.request, Astro.url, { blocks });
const editorOrigin = resolveEditorOrigin(cmssy.editorOrigin);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>cmssy editor</title>
  </head>
  <body>
    <LayoutSlot
      client:load
      groups={layouts}
      position="header"
      page={pageContext}
      locale={locale}
      defaultLocale={defaultLocale}
      enabledLocales={enabledLocales}
      edit={{ editorOrigin }}
      data={editorData?.header?.data}
      resolvedContent={editorData?.header?.resolvedContent}
    />
    <CmssyEditor
      client:load
      page={page}
      locale={locale}
      defaultLocale={defaultLocale}
      enabledLocales={enabledLocales}
      edit={{ editorOrigin, layoutRegions }}
    />
    <LayoutSlot
      client:load
      groups={layouts}
      position="footer"
      page={pageContext}
      locale={locale}
      defaultLocale={defaultLocale}
      enabledLocales={enabledLocales}
      edit={{ editorOrigin }}
      data={editorData?.footer?.data}
      resolvedContent={editorData?.footer?.resolvedContent}
    />
  </body>
</html>

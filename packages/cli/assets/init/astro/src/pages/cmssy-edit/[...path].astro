---
import { loadCmssyPage, resolveEditorOrigin } from "@cmssy/astro";
import { cmssy } from "../../cmssy.config";
import { blocks } from "../../cmssy/blocks";
import CmssyEditor from "../../cmssy/editor";
import LayoutSlot from "../../cmssy/layout-slot";

// The editor iframe lands here (the middleware rewrites verified requests). It
// must be dynamic: a prerendered page never sees the query string.
export const prerender = false;

// `blocks` is what resolves the editor's layout data. Without it the editor
// can select the header and not fill it, and a relation field shows raw ids.
const { page, layouts, locale, defaultLocale, enabledLocales, editorData } =
  await loadCmssyPage(cmssy, Astro.request, Astro.url, { blocks });
const editorOrigin = resolveEditorOrigin(cmssy.editorOrigin);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>cmssy editor</title>
  </head>
  <body>
    <LayoutSlot
      client:load
      groups={layouts}
      position="header"
      locale={locale}
      defaultLocale={defaultLocale}
      enabledLocales={enabledLocales}
      edit={{ editorOrigin }}
      data={editorData?.header?.data}
      resolvedContent={editorData?.header?.resolvedContent}
    />
    <CmssyEditor
      client:load
      page={page}
      locale={locale}
      defaultLocale={defaultLocale}
      enabledLocales={enabledLocales}
      edit={{ editorOrigin }}
    />
    <LayoutSlot
      client:load
      groups={layouts}
      position="footer"
      locale={locale}
      defaultLocale={defaultLocale}
      enabledLocales={enabledLocales}
      edit={{ editorOrigin }}
      data={editorData?.footer?.data}
      resolvedContent={editorData?.footer?.resolvedContent}
    />
  </body>
</html>

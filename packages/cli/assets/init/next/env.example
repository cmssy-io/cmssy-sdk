# `npx @cmssy/cli@latest link --token cs_...` writes all three into .env.local for you.
# Your organization slug (Settings -> Headless in the cmssy dashboard)
CMSSY_ORG_SLUG=
# Your workspace slug (Settings -> Headless in the cmssy dashboard)
CMSSY_WORKSPACE_SLUG=
# Draft/preview secret, generated per workspace (Settings -> Headless)
CMSSY_DRAFT_SECRET=
# Signing secret of the content.changed webhook pointed at /api/revalidate (Settings -> Webhooks)
CMSSY_WEBHOOK_SECRET=
# Optional, server-only: a cs_ API token scoped to this workspace (Dashboard -> API Tokens).
# Server delivery reads send it, so a build is budgeted per workspace, not per IP.
# Delivery reads need no write permission; `cmssy sync-manifest` reads the same var and needs pages:edit.
CMSSY_API_TOKEN=

{
  "name": "@cmssy/astro",
  "version": "12.13.0",
  "description": "Astro bindings for cmssy headless sites: middleware, page loader, sitemap and robots.",
  "keywords": [
    "cmssy",
    "cms",
    "headless",
    "astro"
  ],
  "homepage": "https://cmssy.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmssy-io/cmssy-sdk.git",
    "directory": "packages/astro"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "astro": ">=4.16",
    "@cmssy/react": "^12.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@cmssy/react": "workspace:*"
  },
  "dependencies": {
    "@cmssy/core": "workspace:*"
  }
}
